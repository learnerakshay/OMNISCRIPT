
# OPENAI_API_KEY: Required for OpenAI API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
OPENAI_API_KEY=""

# TAVILY_API_KEY: Required only for the server-side Web Search tool.
# Never expose this value through Vite/NEXT_PUBLIC variables.
TAVILY_API_KEY=""

# APP_URL: Comma-separated browser origins permitted to call this Express API.
# Leave empty for same-origin deployments. Set this to your Vercel frontend URL
# when the frontend and Render API are deployed separately.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional browser-safe base URL for a separately deployed API.
# Leave empty when Vite is served by this Express server. Never put secrets here.
VITE_API_BASE_URL=""

DATABASE_URL=""

# CLERK CONFIGURATION
VITE_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"
